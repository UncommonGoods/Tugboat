# make a copy called .env.dev for docker-compose XO
# SQS / LocalStack queue config
# Endpoint override points the SQS client at the LocalStack container
# instead of real AWS. "localstack" is the compose service hostname.
AWS_ENDPOINT_URL_SQS=http://localstack:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1
TUGBOAT_QUEUE=tugboat-queue

# Other runtime config xo still needs
TUGBOAT_CACHE_PREFIX=TUGBOATDEV
CACHE_URL=redis
CACHE_PORT=6379
TUGBOAT_EASYPOST_API_KEY=abc123_test_4lsdlkjs
# optional
TUGBOAT_PARSEL_API_KEY=
TUGBOAT_ESW_API_KEY=
